# 매튜님(작성자) 환경 전용 — 학습자에게 공유 X
# 이 폴더에는 매튜님이 사용 중인 Claude Code 설정/스킬이 들어 있음.
# 동봉본은 이미 _vendor/anthropic-skill-creator/에 별도로 들어가 있어 중복.
.claude/

# 학습자 개인 데이터 (각 학습자 컴퓨터에만 있어야 함)
_shared/learner-profile.json

# 매튜님 작업 이력 (공유본에는 불필요)
LESSONS_PLAN.md
LESSONS_PLAN_APPENDIX.md

# Mac 시스템 임시 파일
.DS_Store

# 편집기 임시 파일
*~
*.swp
*.tmp
*.bak
.idea/
.vscode/

# 패키지 빌드 산출물
*.zip
*.tar.gz

# 임시 작업 폴더
/tmp/
__pycache__/
.pytest_cache/

# 환경 변수 파일 (혹시라도 있을 경우)
.env
.env.local
.env.*.local
